{
  "name": "kars-byo-agent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "images:build": "node scripts/build-images.mjs",
    "test:containers": "RUN_DOCKER_TESTS=1 node --test tests/containers.test.mjs",
    "test:providers": "RUN_PROVIDER_TESTS=1 node --test tests/providers.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
